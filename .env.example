# ── Required for a production build (the build stops if any is missing) ──────────────────────────────
# Backend API (same Railway API as the public site, https, no trailing slash)
VITE_API_URL=https://stablebackend-production.up.railway.app
# Security pins: admin transactions and Safe signatures only ever use these contracts, this chain and this RPC.
VITE_CHAIN_ID=91342
VITE_RPC_URL=https://sepolia-rpc.giwa.io
VITE_MARKET_ADDRESS=0x...
VITE_FACTORY_ADDRESSES=0x...,0x...
VITE_FEE_VAULT_ADDRESS=0x...
# The Safe multisig that owns STABLE. Needed to sign and execute in Multisig / Treasury (read-only without it).
VITE_SAFE_ADDRESS=0x...

# ── Optional ─────────────────────────────────────────────────────────────────────────────────────────
# Public marketplace URL (for "view on site" links)
VITE_SITE_URL=https://stablemarket.art
# WETH (defaults to the OP Stack predeploy 0x4200000000000000000000000000000000000006)
VITE_WETH_ADDRESS=

# Local development: point these at your local API and chain instead, e.g.
# VITE_API_URL=http://localhost:8080   (and ADMIN_ORIGINS=http://localhost:5174 in backend/.env)
